# --- Docker Compose ---
# Нижний регистр обязателен: ghcr.io требует lowercase.
GITHUB_REPO=pokimoshka/film-react-nest

# nginx.http.conf для локальной разработки, nginx.ssl.conf для прода.
NGINX_CONF=nginx.http.conf

# --- PostgreSQL ---
DATABASE_DRIVER=postgres
DATABASE_USERNAME=exampleuser
DATABASE_PASSWORD=examplepass
DATABASE_NAME=exampledb

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- Логирование бэкенда: dev | json | tskv ---
LOG_FORMAT=dev

# --- Certbot (SSL) ---
CERTBOT_DOMAIN=backpm17yandex.ru
CERTBOT_EMAIL=admin@example.com